# Required
SESSION_SECRET=replace-with-a-long-random-secret

# Local PostgreSQL (used when DATABASE_URL is not set)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=brutal
PGPASSWORD=replace-with-your-postgres-password
PGPORT=5432

# Production alternative:
# DATABASE_URL=postgresql://...
# DATABASE_SSL=true

# Only needed if frontend is hosted separately from this Node server:
# FRONTEND_ORIGIN=https://your-frontend.example
